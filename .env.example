# ─────────────────────────────────────────────────────────────────────────────
# CivilIQ — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://civiliq:civiliq_dev_password@localhost:5432/civiliq_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
# Homebrew local:  redis://localhost:6379
# Upstash cloud:   rediss://default:password@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Anthropic (Claude API) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Google Document AI ──────────────────────────────────────────────────────
# Set these up at: https://cloud.google.com/document-ai
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us  # or eu
GOOGLE_DOCAI_PROCESSOR_ID=your-form-parser-processor-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ─── AWS S3 / Cloudflare R2 ──────────────────────────────────────────────────
# For Cloudflare R2, set endpoint to: https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=civiliq-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=  # Leave empty for AWS, set for R2/MinIO

# ─── OpenAI (Embeddings only) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=CivilIQ
